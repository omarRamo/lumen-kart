<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Used by `xcodebuild -exportArchive` for App Store Connect / TestFlight uploads.
     Replace __APPLE_TEAM_ID__ (10 characters) locally or in CI; never commit a filled-in copy with secrets
     (the Team ID itself is not secret). See store/RELEASE_CHECKLIST.md. -->
<plist version="1.0">
<dict>
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>export</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>teamID</key>
	<string>__APPLE_TEAM_ID__</string>
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
	<key>uploadSymbols</key>
	<true/>
</dict>
</plist>
