<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- appCategory="game": Android 16+ (targetSdk 36) keeps honouring sensorLandscape on tablets and
         foldables for games, instead of forcing resizable/any-orientation.
         allowBackup: the local save (Capacitor Preferences) follows the player to a new phone via
         Android's own encrypted backup. Nothing is ever sent to us. -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:appCategory="game"
        android:usesCleartextTraffic="false"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density|fontScale"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:resizeableActivity="true"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions
         INTERNET: install-time "normal" permission, no prompt. Kept because (1) Capacitor serves the game
         from https://localhost through the WebView, and (2) the optional online mode (only built in when
         VITE_WS_URL is set) needs a WebSocket. The solo game makes no network request.
         VIBRATE is merged from @capacitor/haptics (also a normal permission, no prompt). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Tilt steering is optional; touch-only devices, Chromebooks and gamepads stay supported. -->
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.screen.landscape" android:required="false" />
</manifest>
